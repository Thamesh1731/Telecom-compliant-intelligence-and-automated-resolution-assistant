# ============================================================
# Backend Environment Variables
# ============================================================

# Database: AWS RDS MySQL (or SQLite fallback: sqlite:///./telecom_data.db)
DATABASE_URL=mysql+pymysql://admin:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:3306/telecom_cx

# Knowledge base source: 'local' (default) or 's3' (future)
KNOWLEDGE_BASE_SOURCE=local

# Groq API key for LLM resolution (get free key at https://console.groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Groq model to use (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Hugging Face hosted sentiment model used by the priority engine
HF_TOKEN=your_huggingface_inference_token
SENTIMENT_ENABLED=true
SENTIMENT_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english
SENTIMENT_TIMEOUT_SECONDS=10

# Gmail SMTP sender for technician-resolution notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=telecomcomplaincx@gmail.com
SMTP_FROM=telecomcomplaincx@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS/App Runner/ECS injects PORT automatically; 8000 is the local default.
PORT=8000

# ============================================================
# AWS S3 (optional; enable only after configuring an S3-backed knowledge store)
# ============================================================
# KNOWLEDGE_BASE_SOURCE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=
