# ============================================================
# Backend Environment Variables
# ============================================================

# Knowledge base source: 'local' (default) or 's3' (future)
KNOWLEDGE_BASE_SOURCE=local

# Groq API key for LLM resolution (get free key at https://console.groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Groq model to use (default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Gmail SMTP sender for technician-resolution notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=telecomcomplaincx@gmail.com
SMTP_FROM=telecomcomplaincx@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Complaint request scheduler (in-process single-worker mode)
QUEUE_MAX_CAPACITY=12
QUEUE_CYCLE_SECONDS=1

# ============================================================
# AWS S3 (Future — not required for local development)
# ============================================================
# KNOWLEDGE_BASE_SOURCE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=
